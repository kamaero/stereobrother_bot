# Пример файла переменных окружения для StereoBrother Bot
# Скопируйте этот файл в .env и настройте значения под ваше окружение

# Настройки приложения
APP_NAME=StereoBrother Audio AI Bot
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Настройки сервера
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Настройки базы данных
DATABASE_URL=postgresql://postgres:password@localhost:5432/stereobrother_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Настройки Redis
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10

# Настройки хранилища файлов
STORAGE_TYPE=local  # local, s3, minio
LOCAL_STORAGE_PATH=./storage
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET_NAME=stereobrother-audio
S3_REGION=us-east-1

# Настройки безопасности
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Настройки CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# Настройки лимитов
MAX_FILE_DURATION_MINUTES=10
DAILY_GENERATION_LIMIT=100
SUBSCRIPTION_PRICE_RUB=500

# Настройки обработки аудио
AUDIO_SAMPLE_RATE=44100
AUDIO_CHANNELS=2
AUDIO_BIT_DEPTH=16

# Настройки моделей ИИ
AI_MODELS_PATH=./models
DENOISE_MODEL=demucs
STEM_SEPARATION_MODEL=demucs
ENHANCEMENT_MODEL=audio_super_resolution
MASTERING_MODEL=ai_mastering

# Настройки временных файлов
TEMP_DIR=./temp
TEMP_FILE_RETENTION_HOURS=24
PROCESSED_FILE_RETENTION_DAYS=30

# Настройки очередей задач
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500

# Настройки логирования
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE=./logs/app.log

# Настройки мониторинга
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_PATH=/health

# Настройки платежной системы
PAYMENT_PROVIDER=yookassa  # yookassa, cloudpayments
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
CLOUDPAYMENTS_PUBLIC_ID=your_public_id
CLOUDPAYMENTS_API_SECRET=your_api_secret

# Настройки уведомлений
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=noreply@stereobrother.com

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Настройки кэширования
CACHE_TTL_SECONDS=300
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=60

# Настройки разработки
PYTHONPATH=/app
PYTHONUNBUFFERED=1
TZ=Europe/Moscow

# Дополнительные настройки
# Для использования GPU (если доступно)
# CUDA_VISIBLE_DEVICES=0
# TF_FORCE_GPU_ALLOW_GROWTH=true

# Для отладки
# UVICORN_RELOAD=true
# UVICORN_LOG_LEVEL=debug

# Примечания:
# 1. Для продакшена установите DEBUG=false и ENVIRONMENT=production
# 2. Обязательно измените SECRET_KEY на уникальное значение
# 3. Настройте платежную систему в соответствии с выбранным провайдером
# 4. Для S3 хранилища укажите корректные ключи доступа
# 5. Для email уведомлений настройте SMTP сервер
